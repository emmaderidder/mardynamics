# Generated results. Every run writes a new versioned directory under
# outputs/experiments/, and a run directory is identified by its manifest
# rather than by version control. Committing them would add hundreds of
# megabytes per run and would make the history unusable.
outputs/
data/

# The virtual environment is machine state, not source.
.venv/

# Python and tooling artefacts.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Editor and OS noise.
.DS_Store
Thumbs.db
desktop.ini
